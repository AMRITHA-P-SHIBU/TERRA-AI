# =====================================================
# TERRA AI SERVER CONFIGURATION
# =====================================================

PORT=3000
NODE_ENV=development

# PostgreSQL Connection String
# Example for Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Example for Localhost: postgresql://postgres:postgres@localhost:5432/terra_ai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terra_ai
DB_SSL=false

# Client URL (for CORS and email redirects)
CLIENT_URL=http://localhost:5173

# JWT & Cookie Secrets
JWT_SECRET=super_secret_access_jwt_key_terra_ai_change_in_production_32chars
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_terra_ai_change_in_production_32chars
COOKIE_SECRET=super_secret_cookie_signing_key_terra_ai

# Super Admin Seed Credentials (used by npm run seed:admin)
SUPER_ADMIN_NAME="Terra Chief Admin"
SUPER_ADMIN_EMAIL="admin@terra.eco"
SUPER_ADMIN_PASSWORD="AdminSecurePassword123!"

# Email Service (SMTP or dev console fallback)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Terra AI <no-reply@terra.eco>"

# Optional Supabase and Gemini configurations
SUPABASE_URL=
SUPABASE_ANON_KEY=
GEMINI_API_KEY=
